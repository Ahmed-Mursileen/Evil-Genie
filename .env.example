# Required in production. Without it the API runs in mock mode with canned twists.
DEEPSEEK_API_KEY=
# Optional, defaults to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat

# Optional: write-only wish log. Run supabase/schema.sql first.
# Use the project URL and the anon (public) key: RLS only allows INSERT.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional but recommended on Vercel: shared rate limiting (10/min, 100/day per IP).
# Without these, a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL for share-card links (Vercel's production URL is used otherwise).
NEXT_PUBLIC_SITE_URL=
